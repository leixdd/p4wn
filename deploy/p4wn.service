# Sample systemd unit for p4wn-server on e.g. a 2 vCPU / 2 GB host.
#
# Install:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin p4wn
#   sudo install -m 0755 p4wn-server /usr/local/bin/p4wn-server
#   sudo install -m 0600 /dev/null /etc/p4wn.env
#   echo "P4WN_TOKEN=$(openssl rand -hex 32)" | sudo tee /etc/p4wn.env >/dev/null
#   sudo cp deploy/p4wn.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now p4wn
#   (optional S3 upload: add P4WN_S3_BUCKET / P4WN_S3_ACCESS_KEY /
#    P4WN_S3_SECRET_KEY / P4WN_S3_REGION to /etc/p4wn.env — see README)
#   (upload limit: P4WN_MAX_UPLOAD_MB, default 100. With -workers 1 one job
#    holds its whole PDF in memory next to the page pixmaps — at 100 MB this
#    fits under MemoryMax below; raise MemoryMax before going much higher.)
#   (page limit: P4WN_MAX_PAGES, default 1000. Pages render -page-workers at a
#    time, so memory does not grow with it, but each page's PNG stays in
#    /var/lib/p4wn until the job expires (-ttl, 1 h): budget disk for
#    max pages x ~0.5 MB per job in flight.)
#   (parallelism and page size: P4WN_WORKERS, P4WN_PAGE_WORKERS and
#    P4WN_MAX_MEGAPIXELS in /etc/p4wn.env work too, but the flags on
#    ExecStart below win — drop a flag there to set it from the env file.
#    Worst case ~ workers x page-workers x 7 bytes x megapixel cap: 1 x 2 x
#    ~560 MB at the default 80 MP fits under MemoryMax; see README "Sizing".)
#   (browser uploads: add P4WN_TICKET_SECRET and P4WN_CORS_ORIGINS to
#    /etc/p4wn.env and front the server with deploy/nginx.conf.sample)
#
# Port 8081 matches the Docker image; change as needed.

[Unit]
Description=p4wn PDF to PNG/HTML conversion API
After=network.target

[Service]
User=p4wn
Group=p4wn
# creates /var/lib/p4wn owned by p4wn; stale job dirs there are removed at startup
StateDirectory=p4wn
EnvironmentFile=/etc/p4wn.env
# Go GC soft limit below MemoryMax so the heap is reclaimed before the cgroup OOM-kills
Environment=GOMEMLIMIT=1200MiB
ExecStart=/usr/local/bin/p4wn-server -addr 127.0.0.1:8081 -data-dir /var/lib/p4wn -workers 1 -page-workers 2 -max-dpi 300
Restart=always
RestartSec=2
MemoryMax=1500M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
