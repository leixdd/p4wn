# Copy to .secrets/.env (git-ignored) for `docker compose up`. All optional.

# Bearer token for every route but /healthz (empty = no auth)
P4WN_TOKEN=
# CJK font for non-embedded fonts; put the file in .secrets/fonts/ (mounted at /fonts)
# e.g. P4WN_CJK_FONT=/fonts/NotoSansCJK-Regular.ttc
P4WN_CJK_FONT=
# Largest accepted PDF in MB (1-1024; empty = 100). Each running job holds its
# whole PDF in memory; a proxy in front needs a body limit at least this large.
P4WN_MAX_UPLOAD_MB=
# Most pages one job renders (1-10000; empty = 1000). Each page's PNG stays in
# the data volume until the job expires (-ttl, 1 h).
P4WN_MAX_PAGES=
# Parallelism (README "Sizing"). Jobs converted at once (1-256; empty =
# max(1, CPUs/2)) and pages of one job rendered at once (1-256; empty = 4).
# Rendering is CPU-bound: more than the core count does not speed it up.
#P4WN_WORKERS=
#P4WN_PAGE_WORKERS=4
# Largest page rendered, in megapixels ((0, 400]; empty = 80). Worst-case
# memory ~ workers x page-workers x 7 bytes x this (80 MP ~ 560 MB per page,
# 20 MP ~ 140 MB); lower it to run more in parallel in the same memory.
#P4WN_MAX_MEGAPIXELS=80

# Browser-direct uploads (README "Browser-direct uploads with tickets").
# Shared HMAC secret for upload tickets, at least 32 bytes
# (openssl rand -hex 32); empty = tickets off. Needs P4WN_TOKEN.
P4WN_TICKET_SECRET=
# Origins allowed to POST /v1/jobs from a browser, comma-separated exact
# origins, e.g. https://app.example.com (empty = no CORS headers)
P4WN_CORS_ORIGINS=

# S3 upload of rendered pages (unset bucket = off)
P4WN_S3_BUCKET=
P4WN_S3_ACCESS_KEY=
P4WN_S3_SECRET_KEY=
P4WN_S3_REGION=us-east-1
# S3-compatible endpoint (MinIO, LocalStack, R2, ...); empty = AWS
# e.g. http://host.docker.internal:9000
P4WN_S3_ENDPOINT=
